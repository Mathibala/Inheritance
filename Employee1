
import java.util.Scanner;

// Parent class
class Employees {
    String name;
    double basicSalary;

    // Method to calculate salary (to be overridden)
    double calculateSalary() {
        return basicSalary;
    }
}

// Child class Developer overrides calculateSalary()
class Developers extends Employees {
    double calculateSalary() {
        return basicSalary + (basicSalary * 0.20); // 20% bonus
    }
}

// Child class Manager overrides calculateSalary()
class Manager extends Employees {
    double calculateSalary() {
        return basicSalary + (basicSalary * 0.30); // 30% bonus
    }
}

